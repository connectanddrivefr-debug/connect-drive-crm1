{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "framework": "express",
            "entrypoint": "api/index.js"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ],
    "crons": [
        {
            "path": "/api/cron/quote-reminders",
            "schedule": "0 7 * * *"
        },
        {
            "path": "/api/cron/visit-reminders",
            "schedule": "0 8 * * *"
        },
        {
            "path": "/api/cron/photo-reminders",
            "schedule": "15 8 * * *"
        },
        {
            "path": "/api/cron/installation-reminders",
            "schedule": "30 8 * * *"
        }
    ]
}
