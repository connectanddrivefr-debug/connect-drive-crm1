# --- Base de données ---
# Supabase ou Neon (tier gratuit). DATABASE_URL = connection pooler (pour le runtime serverless)
# DIRECT_URL = connexion directe (pour les migrations Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/connect_drive_crm"
DIRECT_URL="postgresql://user:password@localhost:5432/connect_drive_crm"

# --- Sécurité des crons Vercel ---
CRON_SECRET="choisir-une-chaine-aleatoire"
# À appeler une fois après le premier déploiement: GET /api/setup/seed-admin
SETUP_SECRET="choisir-une-autre-chaine-aleatoire"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="julien@connectanddrive.fr"
ADMIN_PASSWORD="change-me-au-premier-lancement"

# --- Brevo (emailing) ---
# À récupérer dans le compte Brevo existant: SMTP & API > Clés API
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="contact@connectanddrive.fr"
BREVO_SENDER_NAME="Connect & Drive"
# Délai avant relance automatique d'un devis sans réponse (en jours)
QUOTE_REMINDER_DELAY_DAYS=4

# --- Meta Lead Ads webhook ---
META_VERIFY_TOKEN="choisir-un-token-secret-pour-la-verification-webhook"
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""

# --- Webflow (webhook natif "Form submission") ---
# Site settings > Integrations > Webhooks > Add webhook > trigger "Form submission"
# URL = <API_URL>/api/webhooks/webflow — copier la "Secret key" affichée une seule fois.
WEBFLOW_WEBHOOK_SECRET=""

# --- Simulateur de devis connectndrive.fr (2e site, Next.js sur Netlify) ---
# Choisir une chaîne aléatoire, la mettre ici ET dans les variables d'env
# Netlify du site connectndrive.fr (ex: SIMULATEUR_WEBHOOK_SECRET), envoyée
# dans le header x-webhook-secret par le site à chaque soumission.
SIMULATEUR_WEBHOOK_SECRET=""

# --- Webflow (ancienne méthode via Gmail, non utilisée si le webhook natif est configuré) ---
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_WATCH_QUERY="from:notifications@webflow.io is:unread"

# --- Divers ---
PORT=4000
FRONTEND_URL="http://localhost:5173"
