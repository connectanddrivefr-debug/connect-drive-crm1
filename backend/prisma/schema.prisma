// Schéma Connect & Drive CRM
// DB cible: PostgreSQL (Supabase / Neon). Pour dev local rapide, voir DATABASE_URL dans .env

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x: requis pour tourner en serverless sur Vercel (AWS Lambda)
  // native/debian: pour le dev local
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe utilisée uniquement pour les migrations (bypass du pooler)
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Utilisateurs & rôles (Phase 1: un seul compte admin, table prête pour Phase 2)
// ---------------------------------------------------------------------------
enum Role {
  ADMIN       // Julien - tous droits
  COMMERCIAL  // Angélique, Ilham - Phase 2
  TECHNICIEN  // Kevin, Luc - Phase 2
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(ADMIN)

  // Phase 2: routage géographique par zone (ex. plages de codes postaux)
  zoneStart    String?  // ex. "92000"
  zoneEnd      String?  // ex. "92999"

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads Lead[]  @relation("AssignedCommercial")
  notes         Note[]
  calls         CallLog[]
  depositsSent  Lead[]  @relation("DepositSentBy")
  balancesSent  Lead[]  @relation("BalanceSentBy")
}

// ---------------------------------------------------------------------------
// Pipeline leads
// ---------------------------------------------------------------------------
enum LeadStatus {
  NOUVEAU
  CONTACTE
  DEVIS_ENVOYE
  SIGNE
  PERDU
}

enum LeadSource {
  WEBFLOW
  META
  MANUEL
  SIMULATEUR // simulateur de devis du site connectndrive.fr (Netlify)
  AUTRE
}

// ---------------------------------------------------------------------------
// Section "Rappels": visites techniques, demandes de rappel client, photos
// ---------------------------------------------------------------------------
enum TechnicalVisitStatus {
  NON_PROGRAMMEE // pas de visite technique en cours pour ce lead
  A_PROGRAMMER   // à planifier — voir technicalVisitSlots pour les dispos client
  PROGRAMMEE     // planifiée — voir technicalVisitDate
}

enum PhotosStatus {
  NON_DEMANDEES
  EN_ATTENTE // demandées au client, pas encore reçues
  RECUES
}

enum InstallationStatus {
  NON_PROGRAMMEE
  PROGRAMMEE // planifiée — voir installationDate
}

// ---------------------------------------------------------------------------
// Paiements (acompte / solde) — liens de paiement Revolut Business
// ---------------------------------------------------------------------------
// Le CRM crée une "Order" via l'API Merchant Revolut (pas un lien créé à la
// main dans le dashboard Revolut): ça permet d'attacher une référence interne
// (merchant_order_data.order_id = "<leadId>-DEPOSIT" ou "-SOLDE") que Revolut
// renvoie telle quelle dans l'événement webhook ORDER_COMPLETED, ce qui
// permet de retrouver automatiquement le bon lead sans avoir besoin de
// l'email du client (que les liens créés à la main ne permettent pas de
// saisir). Voir integrations/revolut.js.
enum PaymentStatus {
  NON_ENVOYE // pas encore de lien généré
  ENVOYE     // lien généré et envoyé au client, en attente de paiement
  PAYE       // webhook ORDER_COMPLETED reçu et vérifié
}

model Lead {
  id            String     @id @default(uuid())

  // Identité
  firstName     String?
  lastName      String?
  email         String
  phone         String?

  // Adresse
  address       String?
  postalCode    String?
  city          String?

  // Date de signature effective (moment où le statut passe à SIGNE). Sert à
  // regrouper les leads signés par mois pour le suivi des objectifs commerciaux
  // (voir section "Signé" du pipeline) — distinct de updatedAt qui peut
  // changer pour d'autres raisons après la signature.
  signedAt      DateTime?

  // Vérification du numéro de téléphone par SMS (Twilio), mise en place sur
  // le site connectndrive.fr (source SIMULATEUR uniquement — Webflow, Meta et
  // les ajouts manuels/admin n'ont pas ce mécanisme et restent toujours
  // considérés comme vérifiés, valeur par défaut true).
  // Un lead SIMULATEUR avec phoneVerified=false est retiré du pipeline normal
  // et apparaît séparément dans la section "Numéros non vérifiés" (suspicion
  // de spam) — voir GET /api/leads/unverified.
  phoneVerified   Boolean   @default(true)
  phoneVerifiedAt DateTime?

  source        LeadSource @default(MANUEL)
  // Précision libre de la provenance pour les leads ajoutés manuellement
  // (ex: "V2C", "Facebook", "Bouche à oreille") — affichée comme étiquette
  // supplémentaire à côté du badge de source, en plus de la valeur de source.
  sourceDetail  String?
  status        LeadStatus @default(NOUVEAU)

  // Client professionnel (entreprise) plutôt que particulier — affiché
  // comme étiquette "Pro" sur la carte et la fiche du lead.
  isProfessional Boolean   @default(false)

  // --- Section "Rappels" ---
  technicalVisitStatus TechnicalVisitStatus @default(NON_PROGRAMMEE)
  technicalVisitDate   DateTime? // si PROGRAMMEE
  technicalVisitSlots  String?   // créneaux dispo du client si A_PROGRAMMER
  // Empêche de renvoyer plusieurs fois le rappel J-2 pour la même date de visite.
  technicalVisitReminderSentAt DateTime?

  callbackRequested   Boolean   @default(false) // "client à rappeler"
  callbackRequestedAt DateTime?

  photosStatus         PhotosStatus @default(NON_DEMANDEES)
  photosRequestedAt    DateTime?
  // Une seule relance automatique par demande de photos (comme pour les devis).
  photosReminderSentAt DateTime?

  installationStatus InstallationStatus @default(NON_PROGRAMMEE)
  installationDate   DateTime? // si PROGRAMMEE
  // Empêche de renvoyer plusieurs fois le rappel J-2 pour la même date d'installation.
  installationReminderSentAt DateTime?

  // Prix affiché au client à la fin du simulateur de devis (connectndrive.fr),
  // avant tout devis formel envoyé par un commercial (voir modèle Quote).
  estimatedPrice Decimal?  @db.Decimal(10, 2)

  // --- Paiements: acompte ---
  depositAmount      Decimal?      @db.Decimal(10, 2)
  depositStatus      PaymentStatus @default(NON_ENVOYE)
  depositOrderId     String?       // id de l'Order Revolut (uuid)
  depositPaymentLink String?       // checkout_url renvoyé par Revolut
  depositSentAt      DateTime?
  depositSentBy      User?         @relation("DepositSentBy", fields: [depositSentById], references: [id])
  depositSentById    String?
  depositPaidAt      DateTime?

  // --- Paiements: solde ---
  balanceAmount      Decimal?      @db.Decimal(10, 2)
  balanceStatus      PaymentStatus @default(NON_ENVOYE)
  balanceOrderId     String?
  balancePaymentLink String?
  balanceSentAt      DateTime?
  balanceSentBy      User?         @relation("BalanceSentBy", fields: [balanceSentById], references: [id])
  balanceSentById    String?
  balancePaidAt      DateTime?

  // Phase 2: attribution automatique par zone (codePostal -> commercial)
  assignedTo    User?      @relation("AssignedCommercial", fields: [assignedToId], references: [id])
  assignedToId  String?

  notesText     String?    // notes libres (champ rapide en plus du modèle Note)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  statusHistory StatusHistoryEntry[]
  quotes        Quote[]
  emailLogs     EmailLog[]
  notes         Note[]
  calls         CallLog[]

  @@index([status])
  @@index([postalCode])
  @@index([email])
}

model StatusHistoryEntry {
  id        String     @id @default(uuid())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  fromStatus LeadStatus?
  toStatus  LeadStatus
  changedAt DateTime   @default(now())
  changedBy String?    // email ou id user (nullable pour changements automatiques/système)
}

// ---------------------------------------------------------------------------
// Devis
// ---------------------------------------------------------------------------
enum QuoteProduct {
  V2C_TRYDAN
  SMAPPEE_EV_WALL
  AUTRE
}

enum QuoteStatus {
  ENVOYE
  RELANCE
  ACCEPTE
  REFUSE
  EXPIRE
}

model Quote {
  id          String       @id @default(uuid())
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String

  product     QuoteProduct
  amount      Decimal      @db.Decimal(10, 2)
  status      QuoteStatus  @default(ENVOYE)

  sentAt      DateTime     @default(now())
  lastReminderAt DateTime?
  respondedAt DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// Historique des échanges
// ---------------------------------------------------------------------------
enum EmailType {
  CONFIRMATION_LEAD
  NOTIF_INTERNE
  RELANCE_DEVIS
  RAPPEL_INTERNE
  CONFIRMATION_SIGNATURE
  RAPPEL_VISITE
  RAPPEL_PHOTOS
  RAPPEL_INSTALLATION
  AUTRE
}

model EmailLog {
  id        String    @id @default(uuid())
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  type      EmailType
  recipient String
  subject   String
  brevoMessageId String?
  sentAt    DateTime  @default(now())
  success   Boolean   @default(true)
  errorMsg  String?
}

model CallLog {
  id        String   @id @default(uuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  summary   String
  callAt    DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  content   String
  createdAt DateTime @default(now())
}
